# Magma bug patch PNG009 (generated by gen-patch, magma-agent)
# target:   libpng
# pinned:   9e4e247afbe809bac24bf70f531b23427e3f20ec
# upstream: 6a528eb 2025-11-10 "Fix a buffer overflow in `png_do_quantize`"
# cve:      CVE-2025-64505
# class:    oob_read (CWE-125)
# site:     pngrtran.c:png_set_quantize
# canary:   row[i] >= png_ptr->num_palette
# harness:  png_transform_read_fuzzer (new)
# Lines above the first 'diff --git' are ignored by patch(1) and git-apply.
--- a/pngrtran.c
+++ b/pngrtran.c
@@ -501,6 +501,7 @@ png_set_quantize(png_structrp png_ptr, png_colorp palette,
    {
       int i;
 
+#ifdef MAGMA_ENABLE_FIXES
       /* Initialize the array to index colors.
        *
        * Ensure quantize_index can fit 256 elements (PNG_MAX_PALETTE_LENGTH)
@@ -515,6 +516,18 @@ png_set_quantize(png_structrp png_ptr, png_colorp palette,
           PNG_MAX_PALETTE_LENGTH);
       for (i = 0; i < PNG_MAX_PALETTE_LENGTH; i++)
          png_ptr->quantize_index[i] = (png_byte)i;
+#else
+      /* Initialize the array to index colors.
+       *
+       * Be careful to avoid leaking memory. Applications are allowed to call
+       * this function more than once per png_struct.
+       */
+      png_free(png_ptr, png_ptr->quantize_index);
+      png_ptr->quantize_index = (png_bytep)png_malloc(png_ptr,
+          (png_alloc_size_t)num_palette);
+      for (i = 0; i < num_palette; i++)
+         png_ptr->quantize_index[i] = (png_byte)i;
+#endif
    }
 
    if (num_palette > maximum_colors)
@@ -5054,8 +5067,25 @@ png_do_read_transformations(png_structrp png_ptr, png_row_infop row_info)
 
 #ifdef PNG_READ_QUANTIZE_SUPPORTED
    if ((png_ptr->transformations & PNG_QUANTIZE) != 0)
+   {
+#if defined(MAGMA_ENABLE_CANARIES) && !defined(MAGMA_ENABLE_FIXES)
+      if (row_info->bit_depth == 8 &&
+          row_info->color_type == PNG_COLOR_TYPE_PALETTE)
+      {
+         png_const_bytep magma_row = png_ptr->row_buf + 1;
+         size_t magma_i;
+
+         for (magma_i = 0; magma_i < row_info->rowbytes; magma_i++)
+         {
+            MAGMA_LOG("%MAGMA_BUG%",
+                magma_row[magma_i] >= png_ptr->num_palette);
+         }
+      }
+#endif
+
       png_do_quantize(row_info, png_ptr->row_buf + 1,
           png_ptr->palette_lookup, png_ptr->quantize_index);
+   }
 #endif /* READ_QUANTIZE */
 
 #ifdef PNG_READ_EXPAND_16_SUPPORTED
