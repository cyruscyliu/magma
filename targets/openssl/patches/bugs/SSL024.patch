# Magma bug patch SSL024 (generated by gen-patch, magma-agent)
# target:   openssl
# pinned:   61c876198d6f48f146098c5b50ce110ff2b10e7e
# upstream: 38690cab1 2024-05-28 "Only free the read buffers if we're not using them"
# cve:      CVE-2024-4741
# class:    uaf (CWE-416)
# site:     ssl/record/methods/tls_common.c:tls_free_buffers
# canary:   old guard passes while curr_rec != num_released or rstate == SSL_ST_READ_BODY
# harness:  client (existing)
# Lines above the first 'diff --git' are ignored by patch(1) and git-apply.
--- a/ssl/record/methods/tls_common.c
+++ b/ssl/record/methods/tls_common.c
@@ -2147,11 +2147,23 @@ int tls_free_buffers(OSSL_RECORD_LAYER *rl)
     /* Read direction */
 
     /* If we have pending data to be read then fail */
+#ifdef MAGMA_ENABLE_CANARIES
+    MAGMA_LOG("%MAGMA_BUG%",
+              MAGMA_AND(MAGMA_OR(rl->curr_rec >= rl->num_recs,
+                                 TLS_BUFFER_get_left(&rl->rbuf) == 0),
+                        MAGMA_OR(rl->curr_rec != rl->num_released,
+                                 rl->rstate == SSL_ST_READ_BODY)));
+#endif
+#ifdef MAGMA_ENABLE_FIXES
     if (rl->curr_rec < rl->num_recs
         || rl->curr_rec != rl->num_released
         || TLS_BUFFER_get_left(&rl->rbuf) != 0
         || rl->rstate == SSL_ST_READ_BODY)
         return 0;
+#else
+    if (rl->curr_rec < rl->num_recs || TLS_BUFFER_get_left(&rl->rbuf) != 0)
+        return 0;
+#endif
 
     return tls_release_read_buffer(rl);
 }
